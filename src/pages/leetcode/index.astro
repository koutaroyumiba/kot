---
import { getCollection } from "astro:content";

import Layout from "../../layouts/Layout.astro";
import CommandHeading from "../../components/command/CommandHeading.astro";
import LeetcodeRow from "../../components/lists/LeetcodeRow.astro";

const leetcodeEntries = await getCollection(
  "leetcode",
  ({ data }) => !data.draft,
);

leetcodeEntries.sort((a, b) => {
  const dateDifference = b.data.solvedAt.getTime() - a.data.solvedAt.getTime();
  if (dateDifference !== 0) {
    return dateDifference;
  }

  return Number(a.data.questionId) - Number(b.data.questionId);
});
---

<Layout title="Leetcode" description="Leetcode solutions">
  <CommandHeading
    level={1}
    label="Leetcode solutions"
    path="~/leetcode"
    command="ls"
    args="--sort=solved"
  />

  <ul class="structured-list" aria-label="Leetcode solutions">
    {leetcodeEntries.map((entry) => (
      <LeetcodeRow
        solvedAt={entry.data.solvedAt}
        questionId={entry.data.questionId}
        title={entry.data.title}
        difficulty={entry.data.difficulty}
        href={`/leetcode/${entry.id}`}
      />
    ))}
  </ul>
</Layout>
