---
import { getCollection, render, type CollectionEntry } from "astro:content";

import Layout from "../../layouts/Layout.astro";

interface Props {
  entry: CollectionEntry<"leetcode">;
}

export async function getStaticPaths() {
  const collectionEntries = await getCollection(
    "leetcode",
    ({ data }) => !data.draft,
  );

  for (const entry of collectionEntries) {
    if (entry.id !== entry.data.questionId) {
      throw new Error(
        `Leetcode filename "${entry.id}" does not match questionId "${entry.data.questionId}"`,
      );
    }
  }

  return collectionEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const metadata = entry.data;
const { Content } = await render(entry);
---

<Layout>
  <h1>
    <a href="/leetcode">~/leetcode</a> <span class="span-header">$</span>{" "}
    <span>{metadata.questionId}.</span> {metadata.title}
  </h1>
  <div class="frontmatter">
    <a href={metadata.questionUrl} target="_blank">
      Question Link
    </a>
    <p>
      Difficulty: <span>{metadata.difficulty}</span>
    </p>
  </div>
  <Content />
</Layout>

<style is:global>
  .frontmatter {
    margin: 20px;
  }
  .astro-code {
    padding: 5px;
    margin: 10px;
  }
  blockquote,
  .frontmatter {
    border-left: 3px solid var(--primary-blue);
    border-radius: 0px;
    row-gap: 10px;
    padding-left: 20px;
    margin: 20px 0;
  }
</style>
