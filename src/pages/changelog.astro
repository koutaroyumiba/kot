---
import Layout from "../layouts/Layout.astro";
import { changelogReleases } from "../data/changelog";
---

<Layout>
  <h1>
    <span class="span-header">~/changelog</span> ${" "}
    <span class="span-command">cat log</span>
  </h1>
  <p>
    Just like{" "}
    <a href="https://ericzheng.nz/changelog.html" target="_blank">
      Eric
    </a>
    , will change to RSS when time permits
  </p>
  <ul class="sidebar">
    {changelogReleases.map((release) => (
      <li>
        <span class="big-text">{release.version}</span>{" "}
        {release.date && <time datetime={release.date}>{release.date}</time>}
        <p>
          <strong>{release.title}</strong> {release.summary}
        </p>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .big-text {
    font-size: 1.2rem;
  }

  li {
    margin: 10px 0;
  }

  ul {
    list-style-type: none;
  }
</style>
