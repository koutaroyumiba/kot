---
import Layout from "../layouts/Layout.astro";
import AsciiSignature from "../components/home/ASCIISignature.astro";
import CommandHeading from "../components/command/CommandHeading.astro";

const wdcc_link = "https://wdcc.co.nz/";
const devs_link = "https://www.instagram.com/devsuoa/";
const uoacs_link = "https://uoacs.org/";
const tansa_link = "https://www.instagram.com/tansa.uoa/";
---

<Layout>
  <AsciiSignature />

  <CommandHeading
    level={1}
    id="facts"
    label="Facts about me"
    path="~/facts"
    command="grep"
    args="fun"
  />
  <div class="sidebar">
    <ul>
      <li>
        I use neovim, btw (with a{" "}
        <a
          href="https://github.com/koutaroyumiba/nvim"
          target="_blank"
          rel="noopener noreferrer"
        >
          custom config<span class="sr-only"> (opens in a new tab)</span>
        </a>
        ?!?)
      </li>
      <li>
        First in Course Sweep Achieved Semester 1 2025 (first in course award
        for all courses in a semester)
      </li>
      <li>
        Chief Entertainment Officer (CEO) at{" "}
        <a
          href="https://github.com/AGroupForCoders"
          target="_blank"
          rel="noopener noreferrer"
        >
          AGFC<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </li>
      <li>
        Lead Contributor of{" "}
        <a
          href="https://www.instagram.com/ericzhengfanpage/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Eric Zheng's Fan Page
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </li>
    </ul>
  </div>

  <CommandHeading
    level={1}
    id="experience"
    label="Work experience"
    path="~/work/experience"
    command="git log"
    args="--oneline --filter=work"
  />
  <div class="sidebar">
    <ul>
      <li>
        [Nov 2024 - Feb 2026] <span>Software Engineering Intern</span> ----
        Optiver
      </li>
      <li>
        [Jun 2025 - Nov 2025] <span>Graduate Teaching Assistant</span> ----
        University Of Auckland
      </li>
      <li>
        [Nov 2024 - Nov 2025] <span>Software Engineering Intern</span> ----
        NZPMC Ltd.
      </li>
      <li>
        [Feb 2024 - Jun 2025] <span>Teaching Assistant</span> -------------
        University Of Auckland
      </li>
      <li>
        [Nov 2024 - Feb 2025] <span>Summer Research Intern</span> ---------
        University Of Auckland
      </li>
      <li>
        [Jul 2024 - Jul 2024] <span>Jane Street SEE Program</span> -------- Jane
        Street
      </li>
      <li>
        [Mar 2022 - Dec 2024] <span>Private Tutor</span> ------------------
        Sparked Tuition
      </li>
    </ul>
  </div>

  <CommandHeading
    level={1}
    id="leadership"
    label="Leadership roles"
    path="~/leadership/roles"
    command="git log"
    args="--oneline --filter=leadership"
  />
  <div class="sidebar">
    <ul>
      <li>
        [ 1x] <span>Education + Tech Executive</span> -------- (2025) / Web
        Development and Consulting Club (
        <a href={wdcc_link} target="_blank" rel="noopener noreferrer">
          WDCC<span class="sr-only"> (opens in a new tab)</span>
        </a>
        )
      </li>
      <li>
        [ 1x] <span>Competitions + Tech Executive</span> ----- (2025) /
        Developer's Society (
        <a href={devs_link} target="_blank" rel="noopener noreferrer">
          DEVS<span class="sr-only"> (opens in a new tab)</span>
        </a>
        )
      </li>
      <li>
        [ 1x] <span>Senior Advisor</span> -------------- (2024, 2025) /
        University Of Auckland Compsci Society (
        <a href={uoacs_link} target="_blank" rel="noopener noreferrer">
          UOACS<span class="sr-only"> (opens in a new tab)</span>
        </a>
        )
      </li>
      <li>
        [ 1x] <span>Public Relations Officer</span> ---- (2024) / Taiwanese and
        New Zealand Student Association (
        <a href={tansa_link} target="_blank" rel="noopener noreferrer">
          TANSA<span class="sr-only"> (opens in a new tab)</span>
        </a>
        )
      </li>
      <li>
        [ 1x] <span>Activities Coordinator</span> ------ (2023) / Taiwanese and
        New Zealand Student Association (
        <a href={tansa_link} target="_blank" rel="noopener noreferrer">
          TANSA<span class="sr-only"> (opens in a new tab)</span>
        </a>
        )
      </li>
      <li>
        [ 1x] <span>Faculty Representative for Computer Science</span> ---
        (2024) / University of Auckland
      </li>
      <li>
        [12x] <span>Class Representative</span> -------- (2022, 2023, 2024,
        2025) / University of Auckland
        <ul class="ul-no-deco">
          <li>
            \t &gt; 2022 -- <span>CS110</span>, <span>CS120</span>,{" "}
            <span>CS130</span>
          </li>
          <li>
            \t &gt; 2023 -- <span>CS210</span>, <span>CS220</span>,{" "}
            <span>CS367</span>
          </li>
          <li>
            \t &gt; 2024 -- <span>CS361</span>, <span>CS340</span>,{" "}
            <span>CS399</span>
          </li>
          <li>
            \t &gt; 2025 -- <span>CS720</span>, <span>CS747</span>,{" "}
            <span>CS701</span>
          </li>
        </ul>
      </li>
    </ul>
  </div>

  <CommandHeading
    level={1}
    id="footnotes"
    label="Website footnotes"
    path="~/footnotes"
    command="cat"
    args="footnotes"
  />
  <p>
    this website is inspired by my friend's website (
    <a href="https://ericzheng.nz" target="_blank" rel="noopener noreferrer">
      ericzheng.nz<span class="sr-only"> (opens in a new tab)</span>
    </a>
    ). the main reason why this page was created was kind of to have a place to
    put my projects and (more importantly) my <a href="/leetcode">leetcode</a>{" "}
    progress. it's also a nice place to test new things (the website is using
    astro which I used for the first time) and expand my web development
    skillset. hopefully, you find this website cool and check out some of the
    projects that i've been cooking up in <a href="/projects">./projects</a>!
  </p>
  <p>
    feel free to reach out any time via any of my contacts in{" "}
    <a href="/contents">./contents</a>!
  </p>
</Layout>

<style>
  .ul-no-deco {
    list-style: none;
  }
</style>
