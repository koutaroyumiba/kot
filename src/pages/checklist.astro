---
import Layout from "../layouts/Layout.astro";
import CommandHeading from "../components/command/CommandHeading.astro";
import Callout from "../components/content/Callout.astro";
import { checklistItems } from "../data/checklist";
---

<Layout
  title="Checklist"
  description="Current and future improvements planned for this website"
>
  <CommandHeading
    level={1}
    label="Website checklist"
    path="~/checklist"
    command="find"
    args='"future"'
  />
  <Callout>
    Just like{" "}
    <a
      href="https://ericzheng.nz/checklist.html"
      target="_blank"
      rel="noopener noreferrer"
    >
      Eric<span class="sr-only"> (opens in a new tab)</span>
    </a>
    , todo-list of all future additions I am currently thinking about
  </Callout>

  <ul class="structured-list checklist">
    {checklistItems.map((item) => (
      <li
        class:list={[
          "structured-row",
          "checklist__item",
          `checklist__item--${item.status}`,
        ]}
      >
        <span class="checklist__status">
          <span aria-hidden="true">
            {item.status === "completed" ? "- [x]" : "- [ ]"}
          </span>
          <span class="sr-only">
            {item.status === "completed" ? "completed:" : "pending:"}
          </span>
        </span>

        <p class="checklist__title">
          {item.href ? (
            <a href={item.href}>{item.title}</a>
          ) : (
            <span>{item.title}</span>
          )}
        </p>

        {item.completedAt && (
          <span class="checklist__date">
            [completed{" "}
            <time datetime={item.completedAt}>{item.completedAt}</time>]
          </span>
        )}

        {item.note && <p class="checklist__note">&gt; {item.note}</p>}
      </li>
    ))}
  </ul>
</Layout>

<style>
  .checklist {
    margin-top: var(--space-8);
  }

  .checklist__item {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto;
    grid-template-areas: "status title date" ". note note";
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-4) var(--space-2);
  }

  .checklist__status {
    grid-area: status;
    color: var(--color-text-muted);
  }

  .checklist__item--completed .checklist__status {
    color: var(--color-success);
  }

  .checklist__title {
    grid-area: title;
    margin: 0;
  }

  .checklist__title a {
    color: var(--color-link);
  }

  .checklist__item--completed .checklist__title {
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .checklist__date {
    grid-area: date;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    white-space: nowrap;
  }

  .checklist__note {
    grid-area: note;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  @media (max-width: 37.5rem) {
    .checklist__item {
      grid-template-columns: 4rem minmax(0, 1fr);
      grid-template-areas: "status title" ". date" ". note";
    }

    .checklist__date {
      white-space: normal;
    }
  }
</style>
