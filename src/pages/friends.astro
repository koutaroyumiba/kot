---
import Layout from "../layouts/Layout.astro";
import CommandHeading from "../components/command/CommandHeading.astro";
import Callout from "../components/content/Callout.astro";
import { friends } from "../data/friends";
---

<Layout
  title="Friends"
  description="Who doesn't wanna brag about their friends?!"
>
  <CommandHeading
    level={1}
    label="Friends"
    path="~/friends"
    command="echo"
    args='"cool"'
  />
  <Callout>
    <p>
      &gt; during my time at university, I've come across some really cool
      people!
    </p>
    <p>&gt; make sure to give them some love too &lt;3</p>
  </Callout>

  <ul class="structured-list friends-list">
    {friends.map((friend, index) => (
      <li class="structured-row">
        <a
          class="structured-row__link friend-row"
          href={friend.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="friend-row__index" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span class="friend-row__name">
            {friend.name}
            <span class="sr-only"> (opens in a new tab)</span>
          </span>
          <span class="friend-row__domain">{friend.href}</span>
          <span class="structured-row__arrow" aria-hidden="true">
            &#8599;
          </span>
        </a>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .friends-list {
    margin-top: var(--space-8);
  }

  .friend-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: var(--space-4);
  }

  .friend-row__index {
    color: var(--color-text-faint);
    font-size: var(--font-size-small);
    font-variant-numeric: tabular-nums;
  }

  .friend-row__name {
    min-width: 0;
    color: var(--color-text);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .friend-row__domain {
    min-width: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    overflow-wrap: anywhere;
  }

  @media (max-width: 37.5rem) {
    .friend-row {
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      gap: var(--space-2);
    }

    .friend-row__domain {
      grid-column: 2;
      grid-row: 2;
    }

    .structured-row__arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
