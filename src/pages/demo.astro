---
import Layout from "../layouts/Layout.astro";
import CommandHeading from "../components/command/CommandHeading.astro";
import BookRow from "../components/lists/BookRow.astro";

const completionDate = new Date("2025-11-02T00:00:00Z");
---

<Layout title="demo" description="womp womp" noindex>
  <CommandHeading
    level={1}
    label="book demo"
    path="~/demo"
    command="test"
    args="book-row"
  />

  <ul class="structured-list">
    <BookRow
      title="brave new world"
      author="aldous huxley"
      status="reading"
      rating={3}
      favourite
      note="Rereading; previously completed in 2025."
    />
    <BookRow
      title="the alchemist"
      author="paulo coelho"
      status="read"
      rating={5}
      completedAt={completionDate}
      favourite
      note="A reminder to pursue your Personal Legend"
    />
    <BookRow
      title="an intentionally extremely long title that must wrap safely on narrow screens"
      author="paulo coelho"
      status="unread"
    />
  </ul>
</Layout>
