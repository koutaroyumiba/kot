---
import Layout from "../../layouts/Layout.astro";
import CommandHeading from "../../components/command/CommandHeading.astro";
import { thoughts } from "../../data/thoughts";
---

<Layout title="Thoughts" description="Unfinished ideas and writings">
  <CommandHeading
    level={1}
    label="Thoughts and unfinished ideas"
    path="~/thoughts"
    command="grep"
    args={'-R "unfinished ideas"'}
  />

  <p class="thoughts-introduction">
    These are not declarations of certainty. They are checkpoints: attempts to
    give a thought enough structure that someone - including future me - can
    argue with it.
  </p>

  <CommandHeading
    level={2}
    label="Ideas backlog"
    path="~/thoughts"
    command="cat"
    args="backlog.txt"
  />

  <p class="thoughts-count">{thoughts.length} unfinished ideas</p>
  <ol class="thoughts-backlog">
    {thoughts.map((idea) => (
      <li value={idea.id}>
        <span class="thoughts-backlog__index" aria-hidden="true">
          {String(idea.id).padStart(2, "0")}
        </span>
        <span>{idea.title}</span>
      </li>
    ))}
  </ol>
</Layout>

<style>
  .thoughts-introduction {
    max-width: var(--reading-width);
    color: var(--color-text-muted);
  }

  .thoughts-count {
    margin-bottom: var(--space-3);
    color: var(--color-text-faint);
    font-size: var(--font-size-small);
  }

  .thoughts-backlog {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border-width) solid var(--color-border);
  }

  .thoughts-backlog li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-3) var(--space-2);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .thoughts-backlog__index {
    color: var(--color-text-faint);
    font-size: var(--font-size-small);
  }

  @media (max-width: 37.5rem) {
    .thoughts-backlog li {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: var(--space-2);
    }
  }
</style>
