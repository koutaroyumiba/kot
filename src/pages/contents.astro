---
import Layout from "../layouts/Layout.astro";
import CommandHeading from "../components/command/CommandHeading.astro";
import { navigationDestinations } from "../data/navigation";

const internalDestinations = navigationDestinations.filter(
  (destination) =>
    !destination.href.startsWith("http") && destination.href !== "/contents",
);
const externalDestinations = navigationDestinations.filter((destination) =>
  destination.href.startsWith("http"),
);

const sections = [
  {
    id: "internal-pages",
    command: "ls | grep",
    args: '"internal"',
    destinations: internalDestinations,
    external: false,
  },
  {
    id: "external-links",
    command: "ls | grep",
    args: '"external"',
    destinations: externalDestinations,
    external: true,
  },
] as const;
---

<Layout
  title="Contents"
  description="A directory of pages, projects, and contact links."
>
  <CommandHeading
    level={1}
    label="Site Directory"
    path="~/contents"
    command="find"
    args=". --maxdepth=2"
  />

  {sections.map((section) => (
    <section class="directory-section" aria-labelledby={section.id}>
      <CommandHeading
        level={2}
        id={section.id}
        label={section.external ? "External links" : "Internal pages"}
        path="~/contents"
        command={section.command}
        args={section.args}
      />

      <ul class="structured-list">
        {section.destinations.map((destination) => (
          <li class="structured-row">
            <a
              class="structured-row__link directory-row"
              href={destination.href}
              target={section.external ? "_blank" : undefined}
              rel={section.external ? "noopener noreferrer" : undefined}
            >
              <span class="directory-row__title">
                ./{destination.title}
                {section.external && (
                  <span class="sr-only">(opens in a new tab)</span>
                )}
              </span>

              <span class="directory-row__description">
                > {destination.description}
              </span>

              <span class="structured-row__arrow" aria-hidden="true">
                {section.external ? "↗" : "→"}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>

<style>
  .directory-section {
    margin-top: var(--space-8);
  }

  .directory-row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.4fr) minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
  }

  .directory-row__title {
    color: var(--color-link);
    font-weight: 500;
  }

  .directory-row__description {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  @media (max-width: 37.5rem) {
    .directory-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2);
    }

    .directory-row__description {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
