---
import Layout from "../../layouts/Layout.astro";
import BookList from "../../components/books/BookList";
import { books } from "../../data/books";

// note to self:
// 5: must read
// 4: good read
// 3: average read
// 2: maybe not recommend
// 1: poopoo

const sortedBooks = [...books].sort((firstBook, secondBook) =>
  firstBook.author.localeCompare(secondBook.author),
);
---

<Layout>
  <h1>
    <span class="span-header">~/books</span> ${" "}
    <span class="span-command">cat info</span>
  </h1>
  <ul class="list-no-style">
    <li>&gt officially keeping track since 08/07/2025</li>
    <li>
      &gt check out the <a href="/books/hall-of-fame">Hall of Fame</a>
    </li>
  </ul>
  <BookList books={sortedBooks} client:load />
</Layout>

<style>
  li {
    padding: 5px;
  }
</style>
