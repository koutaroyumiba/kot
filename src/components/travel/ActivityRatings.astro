---
import type { CollectionEntry } from "astro:content";

import ExternalLink from "../common/ExternalLink.astro";

type Activity = CollectionEntry<"travel">["data"]["activities"][number];

interface Props {
  activities: Activity[];
}

const { activities } = Astro.props;
---

<ul class="activity-list">
  {activities.map((activity) => (
    <li class="activity">
      <div
        class="activity__rating"
        aria-label={`Rated ${activity.rating} out of 10`}
      >
        <span aria-hidden="true">
          [{String(activity.rating).padStart(2, "_")}/10]
        </span>
      </div>

      <div class="activity__details">
        <h3 class="activity__name">
          {activity.url ? (
            <ExternalLink href={activity.url}>
              {activity.name} <span aria-hidden="true">&#8599;</span>
            </ExternalLink>
          ) : (
            activity.name
          )}
        </h3>

        <p class="activity__metadata">
          {activity.location}
          <span aria-hidden="true"> · </span>
          {activity.category}
        </p>

        {activity.note && <p class="activity__note">{activity.note}</p>}
      </div>
    </li>
  ))}
</ul>

<style>
  .activity {
    display: grid;
    grid-template-columns: 10ch minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .activity-list {
    margin: 0;
    padding: 0;
    border-top: var(--border-width) solid var(--color-border);
    list-style: none;
  }

  .activity__rating {
    color: var(--color-argument);
    font-variant-numeric: tabular-nums;
  }

  .activity__name {
    margin: 0;
    font-size: var(--font-size-body);
  }

  .activity__metadata,
  .activity__note {
    margin: var(--space-1) 0 0;
  }

  .activity__metadata {
    color: var(--color-text-faint);
    font-size: var(--font-size-small);
  }

  @media (max-width: 37.5rem) {
    .activity {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
