---
import { render, type CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/common/date.ts";

type ItineraryDay = CollectionEntry<"itinerary">;

interface Props {
  days: ItineraryDay[];
}

const { days } = Astro.props;
const rendered = await Promise.all(
  days.map(async (entry) => {
    const { Content } = await render(entry);

    return {
      data: entry.data,
      Content,
    };
  }),
);
const formatDay = (day: number) => String(day).padStart(2, "0");
---

<ol class="itinerary">
  {rendered.map(({ data, Content }) => (
    <li class="itinerary__day">
      <header class="itinerary__header">
        <div class="itinerary__marker">day {formatDay(data.day)}</div>

        <div class="itinerary__heading">
          <h3>{data.location}</h3>
          {data.date && (
            <>
              <span class="itinerary__separator" aria-hidden="true">
                &middot;
              </span>
              <time datetime={formatDate(data.date)}>
                [{formatDate(data.date)}]
              </time>
            </>
          )}
        </div>
      </header>

      <div class="itinerary__entry">
        {data.stops.length > 0 && (
          <ul class="itinerary__stops" aria-label={`Stops in ${data.location}`}>
            {data.stops.map((stop, index) => (
              <li>
                {stop}
                {index < data.stops.length - 1 && (
                  <span aria-hidden="true">-&gt;</span>
                )}
              </li>
            ))}
          </ul>
        )}

        <div class="itinerary__notes">
          <Content />
        </div>
      </div>
    </li>
  ))}
</ol>

<style>
  .itinerary {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .itinerary__day {
    display: grid;
    grid-template-columns: 8ch minmax(0, 1fr);
    column-gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: var(--border-width) solid var(--color-border);
  }

  .itinerary__header {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: 8ch minmax(0, 1fr);
    gap: var(--space-4);
  }

  .itinerary__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }

  .itinerary__heading h3 {
    margin: 0;
    font-size: var(--font-size-body);
  }

  .itinerary__heading time {
    color: var(--color-text-faint);
    font-size: var(--font-size-small);
  }

  .itinerary__separator {
    color: var(--color-text-faint);
  }

  .itinerary__day:last-child {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .itinerary__marker {
    color: var(--color-command);
  }

  .itinerary__entry {
    grid-column: 2;
    min-width: 0;
  }

  .itinerary__entry p {
    margin: var(--space-2) 0 0;
  }

  .itinerary__stops {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    margin: var(--space-2) 0 0;
    padding: 0;
    color: var(--color-text-muted);
    list-style: none;
  }

  .itinerary__stops > li {
    margin: 0;
  }

  .itinerary__stops::before {
    margin-right: 1ch;
    color: var(--color-text-faint);
    content: "route:";
  }

  .itinerary__stops span {
    margin-inline: 1ch;
    color: var(--color-text-faint);
  }

  .itinerary__notes {
    margin-top: var(--space-6);
  }

  .itinerary__notes :global(h4) {
    display: block;
    width: fit-content;
    margin: var(--space-2) 0 var(--space-1);
    padding-inline: var(--space-2);
    color: var(--color-command);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-small);
    font-size: var(--font-size-small);
    font-weight: 500;
    text-transform: lowercase;
  }

  .itinerary__notes :global(h4)::before {
    content: "@ ";
  }

  .itinerary__notes :global(h4:first-child) {
    margin-top: 0;
  }

  .itinerary__notes :global(p) {
    margin: 0 0 var(--space-2);
  }

  .itinerary__notes :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 37.5rem) {
    .itinerary__day {
      grid-template-columns: 1fr;
    }

    .itinerary__header {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .itinerary__entry {
      grid-column: 1;
      margin-top: var(--space-4);
    }
  }
</style>
