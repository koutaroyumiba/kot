---
import Layout from "../../layouts/Layout.astro";
import CommandHeading from "../command/CommandHeading.astro";
import Callout from "../content/Callout.astro";

interface Props {
  title: string;
  slug: string;
}

const { title, slug } = Astro.props;
---

<Layout title={title} description={`${title} project write-up pending`} noindex>
  <article class="project-placeholder">
    <nav class="project-placeholder__nav" aria-label="Project navigation">
      <a href="/projects">&#8592; all projects</a>
    </nav>

    <CommandHeading
      level={1}
      label={`${title} project`}
      path="~/projects"
      command="cd"
      args={slug}
    />

    <Callout>
      <p>
        <strong>[pending]</strong> write-up pending.
      </p>
      <p>This project page is being documented.</p>
    </Callout>
  </article>
</Layout>

<style>
  .project-placeholder__nav {
    margin-bottom: var(--space-4);
    font-size: var(--font-size-small);
  }
</style>
