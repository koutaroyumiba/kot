---
import { navigationDestinations } from "../data/navigation";
---

<dialog
  id="jump-palette"
  class="jump-palette"
  aria-labelledby="jump-palette-title"
>
  <div class="jump-palette__shell">
    <header class="jump-palette__header">
      <h2 id="jump-palette-title">
        <span>:</span>jump
      </h2>

      <form method="dialog">
        <button type="submit" value="close" aria-label="Close jump palette">
          esc
        </button>
      </form>
    </header>

    <label for="jump-palette-search">
      <span>~/</span> find destination
    </label>

    <input
      id="jump-palette-search"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="projects, book, leetcode..."
      aria-controls="jump-palette-results"
      aria-describedby="jump-palette-help"
    />

    <p class="sr-only" data-jump-status aria-live="polite" aria-atomic="true">
      {navigationDestinations.length} destinations available
    </p>

    <nav aria-label="Jump destinations">
      <ul id="jump-palette-results" class="jump-palette__results">
        {navigationDestinations.map((destination, index) => (
          <li
            data-jump-item
            data-search={[
              destination.title,
              destination.description,
              destination.href,
              ...destination.keywords,
            ]
              .join(" ")
              .toLowerCase()}
          >
            <a
              href={destination.href}
              data-jump-result
              data-selected={index === 0 ? "true" : "false"}
              aria-current={index === 0 ? "true" : undefined}
            >
              <span>
                <strong>{destination.title}</strong>
                <small>{destination.description}</small>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p id="jump-palette-empty" class="jump-palette__empty" hidden>
      no destinations found
    </p>

    <p id="jump-palette-help" class="jump-palette__help">
      ↑/↓ select · enter open · esc close
    </p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#jump-palette");
  const searchInput = document.querySelector<HTMLInputElement>(
    "#jump-palette-search",
  );
  const trigger = document.querySelector<HTMLElement>("[data-jump-trigger]");
  const emptyMessage = document.querySelector<HTMLElement>(
    "#jump-palette-empty",
  );
  const status = document.querySelector<HTMLElement>("[data-jump-status]");

  if (
    dialog &&
    searchInput &&
    trigger &&
    emptyMessage &&
    status &&
    typeof dialog.showModal === "function"
  ) {
    const items = Array.from(
      dialog.querySelectorAll<HTMLElement>("[data-jump-item]"),
    );

    let visibleItems = [...items];
    let selectedIndex = 0;
    let opener: HTMLElement | null = null;

    const setSelection = (requestedIndex: number, announce = false) => {
      if (visibleItems.length === 0) {
        selectedIndex = -1;
      } else {
        selectedIndex = Math.max(
          0,
          Math.min(requestedIndex, visibleItems.length - 1),
        );
      }

      const selectedItem =
        selectedIndex >= 0 ? visibleItems[selectedIndex] : undefined;

      for (const item of items) {
        const link =
          item.querySelector<HTMLAnchorElement>("[data-jump-result]");
        const isSelected = item === selectedItem;

        if (!link) {
          continue;
        }

        link.dataset.selected = String(isSelected);

        if (isSelected) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      }

      const selectedLink =
        selectedItem?.querySelector<HTMLAnchorElement>("[data-jump-result]");
      selectedLink?.scrollIntoView({ block: "nearest" });

      if (announce && selectedLink) {
        const title = selectedLink.querySelector("strong")?.textContent?.trim();
        status.textContent = `${title ?? "Result"}, ${selectedIndex + 1} of ${visibleItems.length}`;
      }
    };

    const filterResults = () => {
      const queryTokens = searchInput.value
        .trim()
        .toLowerCase()
        .split(/\s+/)
        .filter(Boolean);

      visibleItems = items.filter((item) => {
        const searchableText = item.dataset.search ?? "";
        const matches = queryTokens.every((token) =>
          searchableText.includes(token),
        );
        item.hidden = !matches;
        return matches;
      });

      emptyMessage.hidden = visibleItems.length !== 0;
      setSelection(0);

      const noun = visibleItems.length === 1 ? "destination" : "destinations";
      status.textContent = `${visibleItems.length} ${noun} available`;
    };

    const openPalette = (requestedBy?: HTMLElement) => {
      if (dialog.open) {
        searchInput.focus();
        return;
      }

      opener =
        requestedBy ??
        (document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null);

      searchInput.value = "";
      dialog.showModal();
      filterResults();
      searchInput.focus();
    };

    const isEditableTarget = (target: EventTarget | null) => {
      if (!(target instanceof Element)) {
        return false;
      }

      return Boolean(
        target.closest(
          'input, textarea, select, [contenteditable]:not([contenteditable="false"])',
        ),
      );
    };

    trigger.addEventListener("click", (event) => {
      if (
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.altKey ||
        event.shiftKey
      ) {
        return;
      }

      event.preventDefault();
      openPalette(trigger);
    });

    document.addEventListener("keydown", (event) => {
      if (event.repeat) {
        return;
      }

      const commandShortcut =
        (event.metaKey || event.ctrlKey) &&
        !event.altKey &&
        !event.shiftKey &&
        event.key.toLowerCase() === "k";
      if (commandShortcut) {
        event.preventDefault();
        openPalette();
        return;
      }

      const colonShortcut =
        event.key === ":" && !event.metaKey && !event.ctrlKey && !event.altKey;
      if (colonShortcut && !dialog.open && !isEditableTarget(event.target)) {
        event.preventDefault();
        openPalette();
      }
    });

    searchInput.addEventListener("input", filterResults);
    searchInput.addEventListener("keydown", (event) => {
      switch (event.key) {
        case "ArrowDown":
          event.preventDefault();
          setSelection(selectedIndex + 1, true);
          break;
        case "ArrowUp":
          event.preventDefault();
          setSelection(selectedIndex - 1, true);
          break;
        case "Enter":
          const selectedItem =
            selectedIndex >= 0 ? visibleItems[selectedIndex] : undefined;
          const selectedLink =
            selectedItem?.querySelector<HTMLAnchorElement>(
              "[data-jump-result]",
            );

          if (selectedLink) {
            event.preventDefault();
            selectedLink.click();
          }

          break;
      }
    });

    dialog.addEventListener("close", () => {
      const elementToRestore = opener;
      opener = null;

      if (elementToRestore?.isConnected) {
        elementToRestore.focus();
      }
    });
  }
</script>

<style>
  .jump-palette {
    width: min(36rem, calc(100% - var(--space-6)));
    max-height: 76vh;
    margin: 12vh auto auto;
    padding: 0;
    color: var(--color-text);
    background: var(--color-bg);
    border: var(--border-width) solid var(--color-path);
  }

  .jump-palette::backdrop {
    background: rgb(0 0 0 / 75%);
  }

  .jump-palette__shell {
    padding: var(--space-4);
  }

  .jump-palette__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .jump-palette__header h2 {
    margin: 0;
    font-size: var(--font-size-large);
  }

  .jump-palette__header h2 span {
    color: var(--color-command);
  }

  .jump-palette__header button {
    padding: var(--space-1) var(--space-2);
    color: var(--color-text-muted);
    background: transparent;
    border: var(--border-width) solid var(--color-border);
    cursor: pointer;
  }

  .jump-palette label {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .jump-palette label span {
    color: var(--color-path);
  }

  .jump-palette input {
    width: 100%;
    padding: var(--space-3);
    color: var(--color-text);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
  }

  .jump-palette__results {
    max-height: 46vh;
    margin: var(--space-3) 0 0;
    padding: 0;
    overflow-y: auto;
    list-style: none;
  }

  .jump-palette__results a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .jump-palette__results a[data-selected="true"] {
    color: var(--color-text);
    background: var(--color-surface);
    box-shadow: inset 2px 0 var(--color-path);
  }

  .jump-palette__results strong,
  .jump-palette__results small {
    display: block;
  }

  .jump-palette__results small,
  .jump-palette__results code,
  .jump-palette__help,
  .jump-palette__empty {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .jump-palette__results code {
    flex: 0 0 auto;
  }

  .jump-palette__empty,
  .jump-palette__help {
    margin: var(--space-3) 0 0;
  }
</style>
