---
---

<button
  id="theme-toggle"
  class="theme-toggle underline-animation"
  type="button"
  aria-label="switch to light theme"
  aria-pressed="false"
>
  <span aria-hidden="true">./theme</span>
</button>

<style>
  .theme-toggle {
    --underline-bottom: var(--space-2);

    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    margin: auto;
    padding: var(--space-2);
    color: var(--color-text);
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--color-link);
  }
</style>

<script>
  const root = document.documentElement;
  const button = document.querySelector("#theme-toggle");
  const themeColor = document.querySelector<HTMLMetaElement>("#theme-color");

  if (button instanceof HTMLButtonElement) {
    const getCurrentTheme = () => {
      return root.dataset.theme === "light" ? "light" : "dark";
    };

    const updateButton = () => {
      const currentTheme = getCurrentTheme();
      const nextTheme = currentTheme === "light" ? "dark" : "light";
      button.setAttribute("aria-pressed", String(currentTheme === "light"));
      button.setAttribute("aria-label", `Switch to ${nextTheme} theme`);
    };

    const saveTheme = (theme: "light" | "dark") => {
      try {
        window.localStorage.setItem("theme", theme);
      } catch {
        // storage is unavailable; just change the theme
      }
    };

    const updateThemeColor = (theme: "light" | "dark") => {
      const color =
        theme === "light"
          ? themeColor?.dataset.lightColor
          : themeColor?.dataset.darkColor;
      if (themeColor && color) {
        themeColor.content = color;
      }
    };

    button.addEventListener("click", () => {
      const currentTheme = getCurrentTheme();
      const nextTheme = currentTheme === "light" ? "dark" : "light";
      root.dataset.theme = nextTheme;
      updateThemeColor(nextTheme);
      saveTheme(nextTheme);
      updateButton();
    });

    updateThemeColor(getCurrentTheme());
    updateButton();
  }
</script>
