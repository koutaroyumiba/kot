---
import ThemeToggle from "./ThemeToggle.astro";
import { navigationDestinations } from "../data/navigation";

const navigationItems = navigationDestinations.filter(
  (destination) => destination.primary,
);

const normalizePath = (path: string) => {
  if (path === "/") {
    return path;
  }

  return path.replace(/\/+$/, "");
};

const currentPath = normalizePath(Astro.url.pathname);

const isActive = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="/" aria-label="Koutaro Yumiba home">
      <span class="wordmark__path" aria-hidden="true">
        ~ /
      </span>
      <span aria-hidden="true">ky</span>
      <span class="wordmark__cursor" aria-hidden="true"></span>
    </a>
    <nav class="primary-nav" aria-label="Primary navigation">
      <ul class="primary-nav__list">
        {navigationItems.map((item, index) => (
          <li class="primary-nav__item">
            {index > 0 && (
              <span class="primary-nav__divider" aria-hidden="true">
                /
              </span>
            )}

            <a
              class="primary-nav__link underline-animation"
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a
        class="jump-link"
        href="/contents"
        data-jump-trigger
        aria-haspopup="dialog"
        aria-controls="jump-palette"
        aria-expanded="false"
        aria-keyshortcuts="Control+K Meta+K"
      >
        <span aria-hidden="true">:</span>jump
      </a>

      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .site-header__inner {
    width: 100%;
    min-height: 4.75rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    padding-inline: clamp(var(--space-4), 4vw, var(--space-12));
  }

  .wordmark {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text);
    font-size: var(--font-size-large);
    font-weight: 600;
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--color-text);
  }

  .wordmark__path {
    margin-right: var(--space-2);
    color: var(--color-path);
  }

  .wordmark__cursor {
    width: 0.45rem;
    height: 1.1rem;
    margin-left: var(--space-1);
    background-color: var(--color-argument);
    animation: cursor-blink 1.1s step-end infinite;
  }

  .primary-nav__list {
    display: flex;
    align-items: center;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-nav__item {
    display: flex;
    align-items: center;
  }

  .primary-nav__divider {
    margin-inline: var(--space-3);
    color: var(--color-text-faint);
    user-select: none;
  }

  .primary-nav__link {
    --underline-bottom: var(--space-2);

    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    color: var(--color-text-muted);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
  }

  .primary-nav__link:hover,
  .primary-nav__link[aria-current="page"] {
    color: var(--color-text);
  }

  .primary-nav__link[aria-current="page"]::after {
    transform: scaleX(1) translateY(4px);
  }

  .header-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .jump-link {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding-inline: var(--space-2);
    color: var(--color-text-muted);
    border: var(--border-width) solid var(--color-border);
    font-size: var(--font-size-small);
    text-decoration: none;
  }

  .jump-link:hover {
    color: var(--color-text);
    border-color: var(--color-path);
  }

  .jump-link span {
    color: var(--color-command);
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 43.75rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      padding-block: var(--space-3);
    }

    .primary-nav {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .primary-nav__list {
      justify-content: center;
      gap: 0;
    }

    .primary-nav__divider {
      margin-inline: var(--space-2);
    }

    .header-actions {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
