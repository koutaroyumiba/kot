---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import JumpPalette from "../components/JumpPalette.astro";
import "@fontsource/iosevka/400.css";
import "@fontsource/iosevka/500.css";
import "@fontsource/iosevka/600.css";
import "../styles/global.css";
import "../styles/prose.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  noindex?: boolean;
  prose?: boolean;
}

const {
  title,
  description = "Software engineer, teacher, reader, and community builder based in Auckland.",
  canonicalPath = Astro.url.pathname,
  image,
  noindex = false,
  prose = false,
} = Astro.props;

const siteName = "Koutaro Yumiba";
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(canonicalPath, siteUrl);
const imageUrl = image ? new URL(image, siteUrl) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      id="theme-color"
      name="theme-color"
      content="#171817"
      data-dark-color="#171817"
      data-light-color="#faf4ed"
    />
    <meta name="color-scheme" content="dark light" />

    <script is:inline>
      (() => {
        const systemTheme = window.matchMedia("(prefers-color-scheme: light)")
          .matches
          ? "light"
          : "dark";

        let theme = systemTheme;

        try {
          const storedTheme = window.localStorage.getItem("theme");
          if (storedTheme === "light" || storedTheme === "dark") {
            theme = storedTheme;
          } else if (
            storedTheme === "theme-light" ||
            storedTheme === "theme-dark"
          ) {
            theme = storedTheme === "theme-light" ? "light" : "dark";
            window.localStorage.setItem("theme", theme);
          }
        } catch {
          // storage is unavailable; continue using the system theme
        }

        document.documentElement.dataset.theme = theme;

        const themeColor = document.querySelector("#theme-color");
        if (themeColor instanceof HTMLMetaElement) {
          const color =
            theme === "light"
              ? themeColor.dataset.lightColor
              : themeColor.dataset.darkColor;

          if (color) {
            themeColor.content = color;
          }
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_NZ" />

    <meta
      name="twitter:card"
      content={imageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    {imageUrl && <meta property="og:image" content={imageUrl.href} />}
    {imageUrl && <meta name="twitter:image" content={imageUrl.href} />}

    {noindex && <meta name="robots" content="noindex" />}
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>

    <Header />
    <JumpPalette />

    <main id="main-content" class:list={["site-shell", "site-main", { prose }]}>
      <slot />
    </main>

    <Footer />
  </body>
</html>
